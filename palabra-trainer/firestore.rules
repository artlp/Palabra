rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSheetsAdmin() {
      return request.auth != null
        && request.auth.uid == 'uuDh6U8naZeC7hHv7U3Qex3sAtE2';
    }

    // Общий источник словаря доступен для чтения всем посетителям сайта.
    // Изменять его может только владелец указанного Firebase UID.
    match /appSettings/googleSheets {
      allow read: if true;
      allow create, update: if isSheetsAdmin()
        && request.resource.data.sheetUrl is string
        && request.resource.data.sheetUrl.size() <= 4096
        && request.resource.data.sheetName is string
        && request.resource.data.sheetName.size() <= 200
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isSheetsAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
